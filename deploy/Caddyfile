# SITE_ADDRESS lists the domain hosts; SITE_DOMAIN is the canonical host.
# SITE_IP keeps the existing API entry reachable while clients change domains.
{
	default_sni {$SITE_IP}
}

(site_proxy) {
	encode zstd gzip

	# Originals can be 32 MiB; the app bounds multipart to 33 MiB and stores <= 5 MiB.
	request_body {
		max_size 35MB
	}

	# The gateway authenticates every model request and enforces GPU allocation policy.
	handle_path /_sage/* {
		reverse_proxy {$SAGE_GATEWAY_UPSTREAM:172.18.0.1:18080}
	}
	reverse_proxy app:3000

	log {
		output stdout
		format console
	}
}

{$SITE_ADDRESS} {
	@alias not host {$SITE_DOMAIN}
	redir @alias https://{$SITE_DOMAIN}{uri} permanent
	import site_proxy
}

# IP certificates use the short-lived ACME profile and renew automatically.
{$SITE_IP} {
	tls {
		issuer acme {
			profile shortlived
		}
		issuer internal
	}
	import site_proxy
}

{$PGADMIN_DOMAIN:db.spatialmemory.online} {
	encode zstd gzip
	reverse_proxy pgadmin:80
	log {
		output stdout
		format console
	}
}
