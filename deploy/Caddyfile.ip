# Temporary variant used while the domain cannot be served from a mainland
# server (ICP filing pending): serve https://<server IP> directly.
# Selected by CADDYFILE=Caddyfile.ip in the deploy env file.
#
# Certificate: Let's Encrypt issues publicly trusted IP-address certificates
# (GA since 2026-01-15, https://letsencrypt.org/2026/01/15/6day-and-ip-general-availability)
# but only under the 6-day "shortlived" profile; Caddy renews them
# automatically. If issuance fails, Caddy falls back to its internal CA
# (self-signed: browsers show a warning, but HTTPS — needed for the GPS and
# camera APIs on the on-site capture page — keeps working).
{
	# Clients never send SNI for an IP address, and inside Docker the socket's
	# local address is the container IP, so tell Caddy which certificate to
	# pick when SNI is absent.
	default_sni {$SITE_ADDRESS}
}

{$SITE_ADDRESS} {
	tls {
		issuer acme {
			profile shortlived
		}
		issuer internal
	}
	encode zstd gzip

	request_body {
		max_size 20MB
	}

	reverse_proxy app:3000

	log {
		output stdout
		format console
	}
}
