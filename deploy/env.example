# Copy to deploy/.env.production (git-ignored) and fill in. scripts/deploy.sh
# uploads it to /opt/sanlin/.env on the server; docker-compose reads it for
# both the app container and POSTGRES_PASSWORD / SITE_ADDRESS.

# ── site ──
# Which deploy/Caddyfile* to ship: "Caddyfile" (domain + Let's Encrypt) or
# "Caddyfile.ip" (IP-only HTTPS while ICP filing is pending).
CADDYFILE=Caddyfile
# Both domains need DNS records pointing at SITE_IP. The apex redirects to www.
SITE_ADDRESS='spatialmemory.online, www.spatialmemory.online'
SITE_DOMAIN=www.spatialmemory.online
SITE_IP=139.196.189.102
NEXT_PUBLIC_SITE_URL=https://www.spatialmemory.online
# Keep the existing IP client origin valid during the domain transition.
AUTH_TRUSTED_ORIGINS=https://139.196.189.102

# ── database (the app's DATABASE_URL is derived in docker-compose.yml) ──
POSTGRES_PASSWORD=

# ── auth ──
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Set to true once SMTP works and you want sign-ups to confirm their email.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# HMAC key for SMS verification tickets (lib/auth/sms-ticket.server.ts)
SMS_TICKET_SECRET=

# ── Aliyun (RAM user sanlin-app: OSS bucket + Dypns SMS) ──
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ── media storage ──
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=sanlinlaojie-media
# true on the Shanghai server (free internal endpoint); false elsewhere
OSS_INTERNAL=true
# Public base URL of the bucket: raw endpoint now, media.<domain> once bound.
NEXT_PUBLIC_MEDIA_BASE_URL=https://sanlinlaojie-media.oss-cn-shanghai.aliyuncs.com

# ── map base layer (optional) ──
# 天地图 browser key (https://console.tianditu.gov.cn/). When set, the /manage
# map uses 天地图 imagery instead of Cesium Ion / Bing.
NEXT_PUBLIC_TIANDITU_KEY=

# ── email (optional; Aliyun DirectMail SMTP) ──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── anchor matching (PAI-EAS) ──
# On the Shanghai server use the VPC endpoint (http://<uid>.vpc.cn-shanghai.pai-eas.aliyuncs.com/api/predict/<service>):
# internal network, no TLS handshake. Elsewhere (local dev) use the public https endpoint.
SAGE_EAS_ENDPOINT=
SAGE_EAS_TOKEN=
SAGE_MATCH_THRESHOLD=
SAGE_MATCH_MARGIN=

# ── WeChat mini-program QR codes ──
WECHAT_APPID=
WECHAT_APPSECRET=
